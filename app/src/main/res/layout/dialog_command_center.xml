<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Header with Title, Dossier Subtitle & Close -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCommandCenterTitle"
                    style="@style/TextLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="THE KNIGHT"
                    android:textColor="?attr/primaryColor"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/geist_medium"
                    android:letterSpacing="0.08"
                    android:text="DISCIPLINE TELEMETRY DOSSIER"
                    android:textAllCaps="true"
                    android:textColor="?attr/primaryColorTrans50"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivCloseCommandCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:alpha="0.6"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="8dp"
                android:src="@drawable/ic_close" />
        </FrameLayout>

        <!-- CARD 1: Knight Mastery Level & Rank -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_rect_shade_color"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_medium"
                android:letterSpacing="0.08"
                android:text="KNIGHT MASTERY LEVEL"
                android:textAllCaps="true"
                android:textColor="?attr/primaryColorTrans50"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvRankTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/outfit"
                android:textColor="?attr/primaryColor"
                android:textSize="20sp"
                tools:text="⚔️ SQUIRE OF FOCUS" />

            <ProgressBar
                android:id="@+id/pbRankProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="10"
                android:progressTint="?attr/primaryColor" />

            <TextView
                android:id="@+id/tvRankSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/geist_mono"
                android:letterSpacing="0.04"
                android:textColor="?attr/primaryColorTrans80"
                android:textSize="11sp"
                tools:text="Day 1/100 • 250 XP (750 XP to Vanguard)" />
        </LinearLayout>

        <!-- CARD 2: Daily Discipline Score (0 – 1000 Pts) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_rect_shade_color"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:fontFamily="@font/geist_medium"
                    android:letterSpacing="0.08"
                    android:text="TODAY'S DISCIPLINE SCORE"
                    android:textAllCaps="true"
                    android:textColor="?attr/primaryColorTrans50"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvScoreTierBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_telemetry_badge"
                    android:fontFamily="@font/geist_mono"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="?attr/primaryColor"
                    android:textSize="10sp"
                    tools:text="TIER S • STOIC" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvScoreNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:textColor="?attr/primaryColor"
                    android:textSize="38sp"
                    tools:text="840" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/geist_mono"
                    android:text="/ 1000"
                    android:textColor="?attr/primaryColorTrans50"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Score Vector 1: Habits -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:fontFamily="@font/geist_regular"
                        android:text="Habits Execution"
                        android:textColor="?attr/primaryColorTrans80"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvScoreHabitsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:fontFamily="@font/geist_mono"
                        android:textColor="?attr/primaryColor"
                        android:textSize="11sp"
                        tools:text="400 / 500 pts" />
                </FrameLayout>

                <ProgressBar
                    android:id="@+id/pbScoreHabits"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="4dp"
                    android:max="500"
                    android:progress="400"
                    android:progressTint="?attr/primaryColor" />
            </LinearLayout>

            <!-- Score Vector 2: Screen Time Target -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:fontFamily="@font/geist_regular"
                        android:text="Screen Time Budget"
                        android:textColor="?attr/primaryColorTrans80"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvScoreScreenTimeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:fontFamily="@font/geist_mono"
                        android:textColor="?attr/primaryColor"
                        android:textSize="11sp"
                        tools:text="240 / 250 pts" />
                </FrameLayout>

                <ProgressBar
                    android:id="@+id/pbScoreScreenTime"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="4dp"
                    android:max="250"
                    android:progress="240"
                    android:progressTint="?attr/primaryColor" />
            </LinearLayout>

            <!-- Score Vector 3: Pickups Control -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:fontFamily="@font/geist_regular"
                        android:text="Pickups Discipline"
                        android:textColor="?attr/primaryColorTrans80"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvScorePickupsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:fontFamily="@font/geist_mono"
                        android:textColor="?attr/primaryColor"
                        android:textSize="11sp"
                        tools:text="200 / 250 pts" />
                </FrameLayout>

                <ProgressBar
                    android:id="@+id/pbScorePickups"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="4dp"
                    android:max="250"
                    android:progress="200"
                    android:progressTint="?attr/primaryColor" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 3: 28-Day Consistency Matrix (GitHub-style Heatmap) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_rect_shade_color"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_medium"
                android:letterSpacing="0.08"
                android:text="28-DAY CONSISTENCY MATRIX"
                android:textAllCaps="true"
                android:textColor="?attr/primaryColorTrans50"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvMatrixSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/geist_mono"
                android:textColor="?attr/primaryColor"
                android:textSize="12sp"
                tools:text="88% Continuity • Best: 7 Days • 🔥 1 Streak" />

            <!-- Day Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView style="@style/TextSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/geist_mono" android:gravity="center" android:text="M" android:textColor="?attr/primaryColorTrans50" android:textSize="11sp" />
                <TextView style="@style/TextSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/geist_mono" android:gravity="center" android:text="T" android:textColor="?attr/primaryColorTrans50" android:textSize="11sp" />
                <TextView style="@style/TextSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/geist_mono" android:gravity="center" android:text="W" android:textColor="?attr/primaryColorTrans50" android:textSize="11sp" />
                <TextView style="@style/TextSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/geist_mono" android:gravity="center" android:text="T" android:textColor="?attr/primaryColorTrans50" android:textSize="11sp" />
                <TextView style="@style/TextSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/geist_mono" android:gravity="center" android:text="F" android:textColor="?attr/primaryColorTrans50" android:textSize="11sp" />
                <TextView style="@style/TextSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/geist_mono" android:gravity="center" android:text="S" android:textColor="?attr/primaryColorTrans50" android:textSize="11sp" />
                <TextView style="@style/TextSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/geist_mono" android:gravity="center" android:text="S" android:textColor="?attr/primaryColorTrans50" android:textSize="11sp" />
            </LinearLayout>

            <!-- Matrix Grid Container (populated dynamically) -->
            <LinearLayout
                android:id="@+id/layoutMatrixGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- CARD 4: Milestones & Honors (Text Chips) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_rect_shade_color"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_medium"
                android:letterSpacing="0.08"
                android:text="HONORS &amp; MILESTONES (EARNED)"
                android:textAllCaps="true"
                android:textColor="?attr/primaryColorTrans50"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/layoutMilestonesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
