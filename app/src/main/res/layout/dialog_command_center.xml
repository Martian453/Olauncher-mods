<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Header with Title & Close -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvCommandCenterTitle"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:text="Focus Protocol"
            android:textColor="?attr/primaryColor" />

        <ImageView
            android:id="@+id/ivCloseCommandCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:alpha="0.6"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="8dp"
            android:src="@drawable/ic_close" />
    </FrameLayout>

    <!-- Challenge Progress Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvChallengeDay"
                style="@style/TextMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/primaryColor"
                tools:text="Day 1 of 100" />

            <TextView
                android:id="@+id/tvDaysRemaining"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/primaryColorTrans80"
                tools:text="99 Days Left" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbChallenge"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="1"
            android:progressTint="?attr/primaryColor" />
    </LinearLayout>

    <!-- Streaks & Reality Stats Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_rect_shade_color"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Streak & Consistency Header -->
        <TextView
            android:id="@+id/tvStreakHeader"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/primaryColor"
            tools:text="🔥 1 Streak  •  Best: 1  •  100% Rate" />

        <!-- 2-Column Pickups & Screen Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPickupsCount"
                style="@style/TextSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/primaryColorTrans80"
                tools:text="📱 41 / 50 Pickups" />

            <TextView
                android:id="@+id/tvScreenTimeStats"
                style="@style/TextSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="?attr/primaryColorTrans80"
                tools:text="⏳ 2h 23m Screen Time" />
        </LinearLayout>

        <!-- 7-Day History Strip -->
        <LinearLayout
            android:id="@+id/layoutWeekStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal" />

    </LinearLayout>

    <!-- Today's Habits Header -->
    <TextView
        style="@style/TextSmallBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="TODAY'S HABITS (Tap to Complete)"
        android:textColor="?attr/primaryColorTrans80" />

    <!-- Container for dynamic task items -->
    <LinearLayout
        android:id="@+id/layoutTasksContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnEveningCheckin"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="10dp"
            android:text="Evening Review &amp; Plan"
            android:textColor="?attr/primaryColor"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
