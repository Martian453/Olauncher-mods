<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- App Name & Icon/Label -->
    <TextView
        android:id="@+id/tvFrictionAppName"
        style="@style/TextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/primaryColor"
        android:textSize="24sp"
        tools:text="Instagram" />

    <!-- State 1: Protocol Notice Section (Clean allowance awareness, zero wait timer) -->
    <LinearLayout
        android:id="@+id/layoutFocusNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvNoticeBadge"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_telemetry_badge"
            android:fontFamily="@font/geist_mono"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="🛡️ FOCUS PROTOCOL • GUARDED"
            android:textAllCaps="true"
            android:textColor="?attr/primaryColorTrans80"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_home_tasks_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvAllowanceNotice"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:textColor="?attr/primaryColor"
                android:textSize="22sp"
                tools:text="22m Remaining Today" />

            <TextView
                android:id="@+id/tvAllowanceDetail"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/geist_mono"
                android:textColor="?attr/primaryColorTrans80"
                android:textSize="13sp"
                tools:text="8m used of 30m daily limit" />

            <ProgressBar
                android:id="@+id/progressAllowance"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="27" />

            <TextView
                android:id="@+id/tvNoticeSubtext"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Intention precedes action.\nEvery minute counts towards your daily score."
                android:textColor="?attr/primaryColorTrans50"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnReturnToFocus"
            style="@style/TextSmallBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/rounded_rect_shade_color"
            android:gravity="center"
            android:padding="16dp"
            android:text="Return to Focus"
            android:textColor="?attr/primaryColor"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btnProceedLaunch"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:padding="12dp"
            android:fontFamily="@font/geist_mono"
            android:textColor="?attr/primaryColorTrans80"
            android:textSize="13sp"
            tools:text="Open App (22m left)" />

    </LinearLayout>


    <!-- State 3: Hard Lockout Section -->
    <LinearLayout
        android:id="@+id/layoutHardLockout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Daily Limit Reached"
            android:textColor="?attr/primaryColor"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvLockoutMessage"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="You have used all of your allotted time for this app today.\nStay focused on your protocol."
            android:textColor="?attr/primaryColorTrans80"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnLockoutExit"
            style="@style/TextSmallBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_rect_shade_color"
            android:gravity="center"
            android:padding="14dp"
            android:text="Close App"
            android:textColor="?attr/primaryColor"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnEmergencyBypass"
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="🚨 Request 5-Min Emergency Pass"
            android:textColor="?attr/primaryColorTrans50"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- State 4: Emergency Override Form -->
    <LinearLayout
        android:id="@+id/layoutEmergencyForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🚨 Emergency Override"
            android:textColor="?attr/primaryColor"
            android:textSize="22sp" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="5-minute temporary pass.\nState your genuine reason below to maintain accountability."
            android:textColor="?attr/primaryColorTrans80"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etEmergencyReason"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_rect_shade_color"
            android:gravity="top|start"
            android:hint="Type reason here (min 10 characters)..."
            android:inputType="textMultiLine"
            android:lines="3"
            android:padding="12dp"
            android:textColor="?attr/primaryColor"
            android:textColorHint="?attr/primaryColorTrans50" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancelEmergency"
                style="@style/TextSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="12dp"
                android:text="Cancel"
                android:textColor="?attr/primaryColorTrans80" />

            <TextView
                android:id="@+id/btnConfirmEmergency"
                style="@style/TextSmallBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:padding="12dp"
                android:text="Grant 5-Min Pass"
                android:textColor="?attr/primaryColor"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
