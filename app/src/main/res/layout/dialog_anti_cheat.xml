<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        style="@style/TextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Anti-Cheat Cooldown"
        android:textColor="?attr/primaryColor"
        android:textSize="22sp" />

    <TextView
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Take 60 seconds to pause and reflect before modifying your limits."
        android:textColor="?attr/primaryColorTrans80" />

    <!-- 60s Countdown Timer -->
    <TextView
        android:id="@+id/tvAntiCheatCountdown"
        style="@style/TextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="?attr/primaryColor"
        android:textSize="48sp"
        tools:text="60s" />

    <!-- Pledge Requirement -->
    <TextView
        style="@style/TextSmallBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Type confirmation to proceed:"
        android:textColor="?attr/primaryColorTrans80" />

    <TextView
        android:id="@+id/tvRequiredPledge"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="&quot;I am adjusting my protocol limits&quot;"
        android:textColor="?attr/primaryColor"
        android:textStyle="italic" />

    <EditText
        android:id="@+id/etPledgeInput"
        style="@style/TextMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Type confirmation here..."
        android:inputType="textCapSentences"
        android:textColor="?attr/primaryColor"
        android:textColorHint="?attr/primaryColorTrans50"
        android:textSize="15sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelAntiCheat"
            style="@style/TextSmallBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_rect_shade_color"
            android:gravity="center"
            android:padding="12dp"
            android:text="Cancel"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/btnConfirmAntiCheat"
            style="@style/TextSmallBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:alpha="0.4"
            android:enabled="false"
            android:gravity="center"
            android:padding="12dp"
            android:text="Unlock"
            android:textColor="?attr/primaryColor" />
    </LinearLayout>

</LinearLayout>
