<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    tools:context=".ui.HomeFragment">

    <!-- Placeholder layout for locking screen-->
    <FrameLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/lock_layout_description" />

    <!-- Home button for recents feature disabled -->
    <!-- Placeholder layout for showing recent apps
    <FrameLayout
        android:id="@+id/recents"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@string/recents_layout_description" /> -->

    <!-- Clock and calendar-->
    <LinearLayout
        android:id="@+id/dateTimeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="56dp"
        android:elevation="10dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextClock
            android:id="@+id/clock"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:format12Hour="h:mm"
            android:letterSpacing="-0.03"
            android:textSize="@dimen/time_size"
            tools:text="02:34" />

        <TextView
            android:id="@+id/date"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_regular"
            android:format12Hour="EEE, dd MMM"
            android:format24Hour="EEE, dd MMM"
            android:paddingHorizontal="3dp"
            android:textColor="?attr/primaryColorTrans50"
            android:textSize="@dimen/date_size"
            tools:text="Thu, 30 Dec" />

        <LinearLayout
            android:id="@+id/layoutBannerSplit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvDayCounter"
                style="@style/TextDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/geist_medium"
                android:letterSpacing="0.08"
                android:paddingHorizontal="4dp"
                android:paddingVertical="3dp"
                android:textAllCaps="true"
                android:textColor="?attr/primaryColor"
                android:textSize="12sp"
                tools:text="DAY 1/100" />

            <TextView
                android:id="@+id/tvBannerDivider"
                style="@style/TextDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_regular"
                android:text=" • "
                android:textColor="?attr/primaryColorTrans50"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStreakCounter"
                style="@style/TextDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/geist_medium"
                android:letterSpacing="0.08"
                android:paddingHorizontal="4dp"
                android:paddingVertical="3dp"
                android:textAllCaps="true"
                android:textColor="?attr/primaryColor"
                android:textSize="12sp"
                tools:text="🔥 0 STREAK" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBarMicro"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="160dp"
            android:layout_height="2.5dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="3dp"
            android:max="100"
            android:progress="1"
            android:progressTint="?attr/primaryColor"
            android:progressBackgroundTint="?attr/primaryColorTrans50"
            android:indeterminate="false"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Screen time-->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvScreenTime"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_telemetry_badge"
        android:elevation="10dp"
        android:fontFamily="@font/geist_mono"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textColor="?attr/primaryColorTrans50"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="2h 11m"
        tools:visibility="visible" />

    <!-- Progressive Reflection Slap Overlay -->
    <FrameLayout
        android:id="@+id/layoutPickupSlap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD000000"
        android:clickable="true"
        android:elevation="20dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 Excessive Pickups"
                android:textColor="#FFFF5555"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvPickupSlapMessage"
                style="@style/TextMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Daily pickup limit reached.\nLock the phone and return to your focus."
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvPickupSlapCountdown"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Resuming in 5s..."
                android:textColor="#FFAAAAAA" />
        </LinearLayout>
    </FrameLayout>

    <!-- Side-by-side columns: Apps on one side, Tasks on the other -->
    <LinearLayout
        android:id="@+id/layoutHomeColumns"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="195dp"
        android:paddingBottom="56dp">

        <!-- Apps Column -->
        <LinearLayout
            android:id="@+id/homeAppsLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="52"
            android:gravity="top|start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/homeApp1"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:hint="@string/app"
                android:paddingVertical="@dimen/home_app_padding_vertical"
                android:tag="@string/tag_1"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/homeApp2"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:hint="@string/app"
                android:paddingVertical="@dimen/home_app_padding_vertical"
                android:tag="@string/tag_2"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/homeApp3"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:hint="@string/app"
                android:paddingVertical="@dimen/home_app_padding_vertical"
                android:tag="@string/tag_3"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/homeApp4"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:hint="@string/app"
                android:paddingVertical="@dimen/home_app_padding_vertical"
                android:tag="@string/tag_4"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/homeApp5"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:hint="@string/app"
                android:paddingVertical="@dimen/home_app_padding_vertical"
                android:tag="@string/tag_5"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/homeApp6"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:hint="@string/app"
                android:paddingVertical="@dimen/home_app_padding_vertical"
                android:tag="@string/tag_6"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/homeApp7"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:hint="@string/app"
                android:paddingVertical="@dimen/home_app_padding_vertical"
                android:tag="@string/tag_7"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/homeApp8"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:hint="@string/app"
                android:paddingVertical="@dimen/home_app_padding_vertical"
                android:tag="@string/tag_8"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Tasks Checklist Card Column -->
        <LinearLayout
            android:id="@+id/layoutHomeTasksContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="48"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/cardHomeTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_tasks_card"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvHomeTasksHeader"
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/geist_medium"
                    android:letterSpacing="0.08"
                    android:text="TODAY'S HABITS"
                    android:textAllCaps="true"
                    android:textColor="?attr/primaryColorTrans80"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/layoutHomeTasksItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvHomeTasksSummary"
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/geist_mono"
                    android:letterSpacing="0.04"
                    android:textColor="?attr/primaryColorTrans50"
                    android:textSize="11sp"
                    tools:text="40% Completed • 2/5" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/firstRunTips"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="56dp"
        android:fontFamily="@font/geist_regular"
        android:text="@string/swipe_up_for_apps"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Set default launcher -->
    <TextView
        android:id="@+id/setDefaultLauncher"
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="92dp"
        android:elevation="20dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/geist_medium"
        android:maxLines="1"
        android:text="@string/set_as_default_launcher_u"
        android:visibility="gone" />

    <!-- Minimalist Bottom HUD Navigation Bar (HOME, INDEX, STATS, OPTS) -->
    <LinearLayout
        android:id="@+id/layoutBottomHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="2dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvHudHome"
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/geist_medium"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingVertical="12dp"
            android:text="HOME"
            android:textAllCaps="true"
            android:textColor="?attr/primaryColor"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvHudIndex"
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/geist_medium"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingVertical="12dp"
            android:text="INDEX"
            android:textAllCaps="true"
            android:textColor="?attr/primaryColorTrans50"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvHudStats"
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/geist_medium"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingVertical="12dp"
            android:text="STATS"
            android:textAllCaps="true"
            android:textColor="?attr/primaryColorTrans50"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvHudOpts"
            style="@style/TextSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/geist_medium"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingVertical="12dp"
            android:text="OPTS"
            android:textAllCaps="true"
            android:textColor="?attr/primaryColorTrans50"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>