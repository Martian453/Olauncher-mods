<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_tasks_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist_medium"
        android:letterSpacing="0.08"
        android:text="PROTOCOL DURATION"
        android:textAllCaps="true"
        android:textColor="?attr/primaryColorTrans50"
        android:textSize="11sp" />

    <!-- Circular Dial Container -->
    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="24dp">

        <ProgressBar
            android:id="@+id/dialProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="1"
            android:progressDrawable="@drawable/circle_progress_ring" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialDayNumber"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:textColor="?attr/primaryColor"
                android:textSize="34sp"
                tools:text="DAY 1" />

            <TextView
                android:id="@+id/tvDialDaysRemaining"
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/geist_mono"
                android:letterSpacing="0.04"
                android:textColor="?attr/primaryColorTrans50"
                android:textSize="12sp"
                tools:text="99 Days Left" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvDialPercentCompleted"
        style="@style/TextMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/geist_mono"
        android:letterSpacing="0.04"
        android:textColor="?attr/primaryColor"
        android:textSize="13sp"
        tools:text="1% of 100-Day Protocol completed" />

    <TextView
        android:id="@+id/tvDialQuote"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/geist_regular"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:text="“Discipline is choosing between what you want now and what you want most.”"
        android:textColor="?attr/primaryColorTrans50"
        android:textSize="13sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/btnDialClose"
        style="@style/TextSmallBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/rounded_rect_shade_color"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/geist_medium"
        android:gravity="center"
        android:padding="12dp"
        android:text="Close"
        android:textColor="?attr/primaryColor"
        android:textSize="14sp" />

</LinearLayout>
