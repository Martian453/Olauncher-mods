<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_tasks_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="26dp">

    <TextView
        android:id="@+id/tvGateTag"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist_medium"
        android:letterSpacing="0.08"
        android:text="PROTOCOL FRICTION GATE"
        android:textAllCaps="true"
        android:textColor="?attr/primaryColorTrans50"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvGateTargetName"
        style="@style/TextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/outfit"
        android:textColor="?attr/primaryColor"
        android:textSize="24sp"
        tools:text="Hidden Apps" />

    <TextView
        android:id="@+id/tvGateAccessInfo"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/geist_mono"
        android:letterSpacing="0.04"
        android:textColor="?attr/primaryColorTrans50"
        android:textSize="12sp"
        tools:text="Access #2 today • 60s cooldown" />

    <!-- Countdown Timer Section -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="18dp">

        <ProgressBar
            android:id="@+id/progressGateCountdown"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/circle_progress_ring" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGateSecondsRemaining"
                style="@style/TextLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:textColor="?attr/primaryColor"
                android:textSize="32sp"
                tools:text="30s" />

            <TextView
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_regular"
                android:text="cooldown"
                android:textColor="?attr/primaryColorTrans50"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Math Challenge Section -->
    <LinearLayout
        android:id="@+id/layoutGateMath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/primaryShadeColor"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_medium"
            android:letterSpacing="0.08"
            android:text="EQUATION CHALLENGE"
            android:textAllCaps="true"
            android:textColor="?attr/primaryColorTrans50"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvGateEquation"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/outfit"
            android:textColor="?attr/primaryColor"
            android:textSize="26sp"
            tools:text="38 + 29 = ?" />

        <EditText
            android:id="@+id/etGateMathAnswer"
            style="@style/TextLarge"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:hint="Answer"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="numberSigned"
            android:maxLength="6"
            android:textColor="?attr/primaryColor"
            android:textColorHint="?attr/primaryColorTrans50"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGatePrompt"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/geist_regular"
        android:gravity="center"
        android:text="Pause. Is opening this intentional, or an impulse?"
        android:textColor="?attr/primaryColorTrans50"
        android:textSize="13sp" />

    <!-- Action Buttons -->
    <TextView
        android:id="@+id/btnGateUnlock"
        style="@style/TextSmallBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:alpha="0.4"
        android:background="@drawable/rounded_rect_shade_color"
        android:clickable="true"
        android:enabled="false"
        android:focusable="true"
        android:fontFamily="@font/geist_medium"
        android:gravity="center"
        android:padding="12dp"
        android:text="Unlock (Wait for Timer)"
        android:textColor="?attr/primaryColor"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnGatePutDown"
        style="@style/TextSmallBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/geist_medium"
        android:gravity="center"
        android:padding="12dp"
        android:text="Put Phone Down"
        android:textColor="?attr/primaryColorTrans50"
        android:textSize="13sp" />

</LinearLayout>
