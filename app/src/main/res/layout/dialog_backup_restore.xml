<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        style="@style/TextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Backup &amp; Restore"
        android:textColor="?attr/primaryColor"
        android:textSize="22sp" />

    <TextView
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Safeguard your 100-Day Challenge and habits"
        android:textColor="?attr/primaryColorTrans80"
        android:textSize="14sp" />

    <!-- Export Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_rect_shade_color"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export Progress"
            android:textColor="?attr/primaryColor"
            android:textSize="16sp" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Generates a portable backup of your day count, detox streak, 5 habits, and app limits."
            android:textColor="?attr/primaryColorTrans80"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnExportBackup"
            style="@style/TextSmallBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_rect_shade_color"
            android:gravity="center"
            android:padding="12dp"
            android:text="📤 Export Backup (Copy &amp; Share)"
            android:textColor="?attr/primaryColor"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Import Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_rect_shade_color"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restore Progress"
            android:textColor="?attr/primaryColor"
            android:textSize="16sp" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Paste your backup JSON below to restore your progress:"
            android:textColor="?attr/primaryColorTrans80"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etImportJson"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_rect_shade_color"
            android:gravity="top|start"
            android:hint="Paste backup JSON here..."
            android:inputType="textMultiLine"
            android:lines="3"
            android:maxLines="5"
            android:padding="10dp"
            android:textColor="?attr/primaryColor"
            android:textColorHint="?attr/primaryColorTrans50"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPasteClipboard"
                style="@style/TextSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="10dp"
                android:text="📋 Paste"
                android:textColor="?attr/primaryColorTrans80" />

            <TextView
                android:id="@+id/btnRestoreBackup"
                style="@style/TextSmallBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:padding="10dp"
                android:text="📥 Restore"
                android:textColor="?attr/primaryColor"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnCloseBackup"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:padding="10dp"
        android:text="Close"
        android:textColor="?attr/primaryColorTrans80"
        android:textSize="15sp" />

</LinearLayout>
